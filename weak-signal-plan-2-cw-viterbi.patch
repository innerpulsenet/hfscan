+/// Envelope samples the Viterbi looks ahead before committing a decision.
+///
+/// The survivor paths are carried as bits of a `u64`, so this must stay under
+/// 64. At the 1 kHz envelope rate 48 samples is 48 ms: between half a dit at
+/// 12 WPM and a dit and a half at 35 WPM, which is the range over which a
+/// two-state trellis has comfortably merged. Longer buys nothing and delays
+/// the live envelope pane.
+const VITERBI_LAG: usize = 48;
+
+/// Two-state (space / mark) Viterbi over the keying envelope.
+///
+/// Slicing an envelope sample by sample throws away the one thing that makes
+/// Morse legible at low SNR: elements have a *length*, set by the same clock
+/// that is already being tracked. A hysteresis slicer plus a fixed debounce
+/// is a crude approximation of that — it can only ask "has this lasted longer
+/// than N samples", with one N for both a noise spike inside a space and a
+/// fade inside a dah, and it has to answer immediately.
+///
+/// The trellis asks the question properly. Each sample contributes a
+/// log-likelihood under both hypotheses, each state transition costs what the
+/// dit clock says a transition is worth, and the decision for a sample is
+/// taken once the next `VITERBI_LAG` samples have had their say. A single
+/// noisy sample can no longer key the decoder, and a dropout in the middle of
+/// a dah is bridged rather than splitting it into two dits — which is exactly
+/// how weak CW shreds.
+struct KeyViterbi {
+    /// Path metric per state, renormalised each step so it cannot drift.
+    metric: [f32; 2],
+    /// Survivor path for each state, one bit per sample, newest in bit 0.
+    hist: [u64; 2],
+    filled: usize,
+}
+
+impl KeyViterbi {
+    fn new() -> Self {
+        Self { metric: [0.0, 0.0], hist: [0, 0], filled: 0 }
+    }
+
+    fn reset(&mut self) {
+        *self = KeyViterbi::new();
+    }
+
+    /// Advance one sample. Returns the committed decision for the sample
+    /// `VITERBI_LAG` steps back, once that many have been seen.
+    ///
+    /// `mu0`/`mu1` are the settled space and mark envelope levels, `sigma`
+    /// the envelope noise spread, and `dwell` the expected number of samples
+    /// spent in each state — one dit is the shortest element, so the
+    /// probability of leaving a state on any given sample is about `1/dwell`.
+    fn step(&mut self, env: f32, mu0: f32, mu1: f32, sigma: f32, dwell: f32) -> Option<bool> {
+        let inv2s2 = 1.0 / (2.0 * sigma * sigma).max(1e-12);
+        let e0 = -(env - mu0) * (env - mu0) * inv2s2;
+        let e1 = -(env - mu1) * (env - mu1) * inv2s2;
+        // A geometric dwell: leaving costs ln(dwell), staying costs almost
+        // nothing. Taken from the tracked clock, so a fast fist is allowed to
+        // switch more freely than a slow one.
+        let leave = -(dwell.max(2.0)).ln();
+        let stay = -1.0 / dwell.max(2.0);
+
+        let mut next = [0.0f32; 2];
+        let mut hist = [0u64; 2];
+        for (s, emit) in [(0usize, e0), (1usize, e1)] {
+            let from_same = self.metric[s] + stay;
+            let from_other = self.metric[1 - s] + leave;
+            let (m, prev) = if from_same >= from_other {
+                (from_same, s)
+            } else {
+                (from_other, 1 - s)
+            };
+            next[s] = m + emit;
+            hist[s] = (self.hist[prev] << 1) | s as u64;
+        }
+        let best = next[0].max(next[1]);
+        self.metric = [next[0] - best, next[1] - best];
+        self.hist = hist;
+
+        if self.filled < VITERBI_LAG {
+            self.filled += 1;
+            return None;
+        }
+        let s = usize::from(self.metric[1] > self.metric[0]);
+        Some((self.hist[s] >> VITERBI_LAG) & 1 == 1)
+    }
+}
